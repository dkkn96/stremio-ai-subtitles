# Prefer npm run setup. Keep the real .env private.
AI_PROVIDER=codex
AI_MODEL=gpt-6-luna
AI_REASONING=max
CODEX_SERVICE_TIER=fast
SOURCE_LANGUAGE=eng
TARGET_LANGUAGE=hun
PORT=7017
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:7017
SOURCE_ADDON_URL=https://opensubtitles-v3.strem.io/manifest.json
FALLBACK_SOURCE_ADDON_URL=
PREFER_EXISTING=true
MAX_NEW_JOBS_PER_DAY=20
MAX_ACTIVE_JOBS=1
MAX_QUEUED_JOBS=4
BATCH_SIZE=50
BATCH_CONCURRENCY=2
PROVIDER_TIMEOUT_SECONDS=180
DELIVERY_WAIT_SECONDS=45
RETRY_COOLDOWN_SECONDS=300
# API is optional, never a fallback. Read docs/PROVIDERS.md before enabling.
ALLOW_PAID_API=false
AI_API_KEY=
AI_API_BASE_URL=
# ADDON_TOKEN is generated once in data/addon-token; do not invent a short password.
